{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "node .claude/scripts/check-html.mjs" }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(node .claude/scripts/check-html.mjs:*)",
      "Bash(node .claude/scripts/serve.cjs:*)",
      "Bash(curl:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git ls-files:*)"
    ]
  }
}
