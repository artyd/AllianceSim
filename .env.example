# Copy to .env and fill in real values before `docker compose up`.
# Generate strong secrets with:  openssl rand -hex 24

POSTGRES_USER=alliancesim
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=alliancesim

# HR access code for Builder mode. This is the simple code HR types once in the
# browser to be able to save the office layout. Required — the API refuses writes
# if unset. Keep it short and memorable (e.g. alliance2025) and share it only with
# the HR team. Everyone else opens the read-only share link (?mode=viewer).
EDIT_TOKEN=alliance2025

# Port the api container listens on / is mapped to on 127.0.0.1 (Caddy proxies here).
PORT=8011

# ── Telegram bot ────────────────────────────────────────────────────────────
# Token from @BotFather (https://t.me/BotFather → /newbot). Required for the bot
# service to start. The bot lets staff self-create their office character, sends a
# weekday morning check-in, and relays phone notifications from the site.
TELEGRAM_BOT_TOKEN=

# Daily check-in time (hour, 24h) and timezone. Sent Mon–Fri.
CHECKIN_HOUR=9
CHECKIN_TZ=Europe/Kyiv

# Public https URL of the site — opened as a Telegram Mini App (menu button + inline
# button). Leave empty to disable the Mini App. Must be https (Telegram requirement).
WEBAPP_URL=https://alliancesim.alliancegroup95.com/

# Coffee orders from the phone are delivered to this HR in Telegram. Set the telegram
# id (COFFEE_HR_TG, most stable) OR a linked employee name (COFFEE_HR_NAME). The
# recipient must have created/claimed their character so the bot can message them.
COFFEE_HR_TG=
COFFEE_HR_NAME=Тахтаулова Аліна
