# Copy to .env and fill in real values before `docker compose up`.
# Generate strong secrets with:  openssl rand -hex 24

POSTGRES_USER=alliancesim
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=alliancesim

# HR access code for Builder mode. This is the simple code HR types once in the
# browser to be able to save the office layout. Required — the API refuses writes
# if unset. Keep it short and memorable (e.g. alliance2025) and share it only with
# the HR team. Everyone else opens the read-only share link (?mode=viewer).
EDIT_TOKEN=alliance2025

# Port the api container listens on / is mapped to on 127.0.0.1 (Caddy proxies here).
PORT=8011
